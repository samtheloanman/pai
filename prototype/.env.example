# copy to .env
LITELLM_MASTER_KEY=sk-change-me
# Local model (Hugging Face repo:quant). 16 GB: Qwen3-4B; 32-64 GB laptop: Qwen3-30B-A3B.
MODEL_HF=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
# MODEL_HF=unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M
# Optional cloud setup mode (answers leave the box). Free model IDs change; check openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LITELLM_CONFIG=litellm.local.yaml
