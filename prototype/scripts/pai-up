#!/bin/sh
# Runs `docker compose` with the vault key passed as a Compose secret, so the key never sits in .env or in the
# app container's environment.
#   scripts/pai-up up -d --build          any docker compose arguments
#   scripts/pai-up new-key                make a fresh key in the key store (refuses if one exists)
#   <key on stdin> | scripts/pai-up import-key   store an existing key (e.g. the one you used so far)
#   scripts/pai-up migrate-key            move a PAI_VAULT_KEY line out of .env into the key store
#   scripts/pai-up has-key                exit 0 if a stored key exists
# Key store, best first (override with PAI_KEY_STORE=keychain|systemd|file):
#   macOS:  the Keychain (service pai-vault-key). Shortcut: the key is briefly on the `security` command line.
#   Linux:  a systemd credential, $PAI_CONFIG_DIR/vault-key.cred, encrypted with `systemd-creds encrypt` when that
#           works without a password prompt; otherwise a mode-0600 file, $PAI_CONFIG_DIR/vault-key.
#   PAI_CONFIG_DIR defaults to ~/.config/pai. A legacy PAI_VAULT_KEY in .env still works but prints a warning.
# The PAI OS image uses a TPM-sealed systemd credential instead (the app reads it from $CREDENTIALS_DIRECTORY/vault-key).
set -eu
cd "$(dirname "$0")/.."
SVC=pai-vault-key
CONF="${PAI_CONFIG_DIR:-$HOME/.config/pai}"
KEYFILE="$CONF/vault-key"
CRED="$CONF/vault-key.cred"

store_kind() {
  case "${PAI_KEY_STORE:-}" in
    keychain|systemd|file) echo "$PAI_KEY_STORE"; return ;;
    "") ;;
    *) echo "PAI_KEY_STORE must be keychain, systemd or file" >&2; exit 1 ;;
  esac
  if [ "$(uname -s)" = Darwin ] && command -v security >/dev/null 2>&1; then echo keychain
  elif [ -f "$CRED" ]; then echo systemd
  elif [ -f "$KEYFILE" ]; then echo file
  elif systemd_ok; then echo systemd
  else echo file
  fi
}

# systemd-creds flavours: --user (systemd 256+, unprivileged), host key (root), TPM2 only (users in the tss group).
creds_encrypt() {  # key on stdin, writes $CRED
  for f in --user "" --with-key=tpm2; do
    # shellcheck disable=SC2086  # $f is one flag or empty on purpose
    systemd-creds $f encrypt --name=vault-key - "$1" 2>/dev/null && { echo "$f"; return 0; }
  done
  return 1
}
creds_decrypt() {
  for f in --user "" --with-key=tpm2; do
    # shellcheck disable=SC2086
    systemd-creds $f decrypt --name=vault-key "$1" - 2>/dev/null && return 0
  done
  return 1
}
systemd_ok() {  # a round trip must work non-interactively, or we fall back to the key file
  command -v systemd-creds >/dev/null 2>&1 || return 1
  t="$(mktemp)"
  if printf 'probe' | creds_encrypt "$t" >/dev/null && [ "$(creds_decrypt "$t")" = probe ]; then rm -f "$t"; return 0; fi
  rm -f "$t"; return 1
}

have() {
  case "$(store_kind)" in
    keychain) security find-generic-password -s "$SVC" >/dev/null 2>&1 ;;
    systemd) [ -s "$CRED" ] ;;
    file) [ -s "$KEYFILE" ] ;;
  esac
}
read_key() {
  case "$(store_kind)" in
    keychain) security find-generic-password -s "$SVC" -w ;;
    systemd) creds_decrypt "$CRED" || { echo "cannot decrypt $CRED with systemd-creds" >&2; return 1; } ;;
    file)
      perms="$(stat -c %a "$KEYFILE" 2>/dev/null || stat -f %Lp "$KEYFILE")"
      [ "$perms" = 600 ] || [ "$perms" = 400 ] || echo "warning: $KEYFILE is mode $perms; run: chmod 600 $KEYFILE" >&2
      tr -d '[:space:]' < "$KEYFILE" ;;
  esac
}
store() {  # never overwrites: callers check have() first
  case "$(store_kind)" in
    keychain) security add-generic-password -U -a "$USER" -s "$SVC" -w "$1" >/dev/null; where="the macOS Keychain ($SVC)" ;;
    systemd)
      (umask 077; mkdir -p "$CONF")
      printf '%s' "$1" | creds_encrypt "$CRED" >/dev/null || { echo "systemd-creds encrypt failed" >&2; exit 1; }
      chmod 600 "$CRED"; where="$CRED (systemd-creds encrypted)" ;;
    file)
      (umask 077; mkdir -p "$CONF"; t="$(mktemp "$CONF/.vault-key.XXXXXX")"; printf '%s\n' "$1" > "$t"; mv "$t" "$KEYFILE")
      chmod 700 "$CONF"; chmod 600 "$KEYFILE"; where="$KEYFILE (mode 0600)" ;;
  esac
  [ "$(read_key)" = "$1" ] || { echo "stored the key but could not read it back from $where" >&2; exit 1; }
}
env_key() { [ -f .env ] || return 0; grep '^PAI_VAULT_KEY=' .env | tail -n 1 | cut -d= -f2- | tr -d '[:space:]'; }

case "${1:-}" in
  has-key) have ;;
  new-key)
    have && { echo "A vault key is already stored; refusing to replace it (that would lock the vault)." >&2; exit 1; }
    store "$(openssl rand -hex 32)"; echo "Vault key created in $where. Back it up off this computer: losing it loses the vault." ;;
  import-key)
    IFS= read -r k || [ -n "$k" ]; [ -n "$k" ] || { echo "empty key on stdin" >&2; exit 1; }
    have && { echo "A vault key is already stored; refusing to replace it." >&2; exit 1; }
    store "$k"; echo "Vault key imported to $where." ;;
  migrate-key)
    k="$(env_key)"
    [ -n "$k" ] || { echo "No PAI_VAULT_KEY in .env; nothing to migrate."; exit 0; }
    if have; then
      [ "$(read_key)" = "$k" ] || { echo "PAI_VAULT_KEY in .env differs from the stored key. Left both untouched: decide which one opens your vault, then remove the other." >&2; exit 1; }
      where="the key store"
    else
      store "$k"
    fi
    t="$(mktemp .env.XXXXXX)"; grep -v '^PAI_VAULT_KEY=' .env > "$t" || true
    chmod 600 "$t"; mv "$t" .env
    echo "Moved PAI_VAULT_KEY out of .env into $where and removed the line from .env." ;;
  *)
    if have; then
      k="$(read_key)"; PAI_VAULT_KEY="$k" exec docker compose "$@"
    elif [ -n "${PAI_VAULT_KEY:-}" ]; then
      exec docker compose "$@"
    elif [ -n "$(env_key)" ]; then
      echo "warning: the vault key is in .env in plain text. Run: scripts/pai-up migrate-key" >&2
      PAI_VAULT_KEY="$(env_key)" exec docker compose "$@"
    else
      echo "No vault key in the key store, environment, or .env. Run: scripts/pai-up new-key  (or set PAI_VAULT_KEY)." >&2; exit 1
    fi ;;
esac
